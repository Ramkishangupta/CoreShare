# Orchestrator Configuration for College Network Deployment
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=3000

# IMPORTANT: Replace with your server's actual network IP address
# Find it using: ipconfig (Windows) or hostname -I (Linux)
SERVER_IP=192.168.1.100

# Database Configuration
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://gpu_user:your_secure_password@localhost:5432/gpu_rental

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Security - CHANGE THESE VALUES!
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
WORKER_SECRET_TOKEN=worker-token-change-this-to-something-secure

# CORS - Allow frontend to access API
# Use your server's network IP, not localhost
CORS_ORIGIN=http://192.168.1.100:3001

# Pricing Configuration (dollars per minute)
GPU_PRICE_PER_MINUTE=0.10
CPU_PRICE_PER_MINUTE=0.02

# Initial User Credits
INITIAL_CREDITS=100

# Logging
LOG_LEVEL=info

# Environment
NODE_ENV=production
