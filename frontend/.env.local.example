# Frontend Environment Configuration
# Copy this file to .env.local and update with your actual values

# API URL - Set to your orchestrator server's IP address
# For local development: http://localhost:3000/api
# For network deployment: http://192.168.1.100:3000/api (replace with your server IP)
NEXT_PUBLIC_API_URL=http://192.168.1.100:3000/api

# WebSocket URL - Set to your orchestrator server's IP address
# For local development: http://localhost:3000
# For network deployment: http://192.168.1.100:3000 (replace with your server IP)
NEXT_PUBLIC_WS_URL=http://192.168.1.100:3000
